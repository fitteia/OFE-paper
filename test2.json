{"AscaleX":"no","AscaleY":"no","AuxCode":"#include <stdio.h>\r\n#include <math.h>\r\n#include \"globals.h\"\r\n#include \"struct.h\"\r\n\r\n#define pi 3.1415926\r\n#define k 1.380649e-23\r\n#define hbar 1.054571817e-34\r\n#define MAX 5.0\r\n\r\ndouble R1C(double f, double T, double gH, double gS, double N, double S, double d, double D, double NP)\r\n{\r\n  double w, wS, A, B, Sc, tau, result;\r\n  double Bs(), CDD(), jMP();\r\n\r\n  tau=d*d/D;\r\n  w=2*pi*f;\r\n  wS=gS/gH*w;\r\n  Sc=S*Bs(wS, S, T);\r\n\r\n  result=432.0/5.0*CDD(gH, gS, N, d, tau)*Sc*Sc*jMP(w*tau,0.0,NP);\r\n  return result;\r\n} \r\n\r\ndouble R1Fn(double f, double T, double gH, double gS, double N, double S, double d, double D, double T1e, double NP)\r\n{\r\n  double w, wS, A, B, Sc,Sz2, tau, result;\r\n  double Bs(), CDD(), jMP();\r\n\r\n  tau=d*d/D;\r\n  w=2*pi*f;\r\n  wS=gS/gH*w;\r\n  Sc=S*Bs(wS, S, T);\r\n  Sz2=S*(S+1)-Sc/tanh(hbar*wS/(2*k*T))-Sc*Sc;\r\n\r\n  result=432.0/5.0*CDD(gH, gS, N, d, tau)*Sz2*jMP(w*tau,tau/T1e,NP);\r\n  return result;\r\n} \r\n\r\ndouble R1Fe(double f, double T, double gH, double gS, double N, double S, double d, double D, double T2e, double NP)\r\n{\r\n  double w, wS, A, B, Sc, tau, result;\r\n  double Bs(), CDD(), jMP();\r\n\r\n  tau=d*d/D;\r\n  w=2*pi*f;\r\n  wS=gS/gH*w;\r\n  Sc=S*Bs(wS, S, T);\r\n\r\n  result=1008.0/5.0*CDD(gH, gS, N, d, tau)*Sc/tanh(hbar*wS/(2*k*T))*jMP(wS*tau,tau/T2e,NP);\r\n  return result;\r\n} \r\ndouble Bs(double wS, double S, double T)\r\n{\r\n  return 1.0/tanh(S*hbar*wS/(k*T))-1.0/(2*S*tanh(hbar*wS/(2*k*T)));\r\n}\r\n\r\ndouble CDD(double gH, double gS, double N, double d, double tau)\r\n{\r\n  double result; \r\n  result=pow(1e-7*gH*gS*hbar,2.0)*N*tau/(d*d*d);\r\n  return result; \r\n}\r\n\r\ndouble jMP(double a, double b, double NP)\r\n{\r\n  double result=0.0;\r\n  int np;\r\n  double sqgausn(),j_int1(),j_int2();\r\n  void w_f_ptr(),clear_struct();\r\n  Function X;\r\n\r\n  clear_struct(&X,3);\r\n\r\n  a=fabs(a); \r\n  b=fabs(b);\r\n\r\n  X.par[1].val = fabs(a);\r\n  X.par[2].val = fabs(b);\r\n  np = (int) NP;\r\n  \r\n  if( a == 0.0 && b == 0.0 ) {\r\n      X.par[0].low_v  = 0.0;\r\n      X.par[0].high_v = MAX;\r\n      w_f_ptr(&X,j_int1);\r\n      result = sqgausn(&X,0, np);\r\n  }\r\n  else if (a == 0.0 && b > 0.0) {\r\n      w_f_ptr(&X,j_int2);\r\n\r\n      X.par[0].low_v  = 0.0;\r\n      X.par[0].high_v = sqrt(b);\r\n      result = sqgausn(&X,0, np);\r\n\r\n      X.par[0].low_v  = sqrt(b);\r\n      X.par[0].high_v = MAX;\r\n      result += sqgausn(&X,0, np);\r\n  }\r\n  else if (a > 0.0) {\r\n    w_f_ptr(&X,j_int2);\r\n\r\n    X.par[0].low_v  = 0.0;\r\n    X.par[0].high_v = sqrt(a);\r\n    result = sqgausn(&X,0, np);\r\n    \r\n    X.par[0].low_v  = sqrt(a);\r\n    X.par[0].high_v = MAX;\r\n    result += sqgausn(&X,0, np);\r\n  }\r\n  else { printf(\"ERROR in jG. Case not defined\\n\"); }\r\n  \r\n  return result;\r\n}\r\n\r\ndouble j_int1(Function *X)\r\n{\r\n  double u,a,b;\r\n  double r_pval();\r\n\r\n  u = r_pval(X,0);\r\n  a = r_pval(X,1);\r\n  b = r_pval(X,2);\r\n  \r\n  return 1.0/(81+9*u*u-2*u*u*u*u+pow(u,6.0));\r\n}\r\n\r\ndouble j_int2(Function *X)\r\n{\r\n  double u,a,b,y;\r\n  double r_pval();\r\n  \r\n  u = r_pval(X,0);\r\n  a = r_pval(X,1);\r\n  b = r_pval(X,2);\r\n  \r\n  return u*u/(81+9*u*u-2*u*u*u*u+pow(u,6.0))*(u*u+b)/((u*u+b)*(u*u+b)+a*a);\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n","AuxDeclar":"double R1C(), R1Fn(), R1Fe()","Cor0":"2-red","Cor1":"3-green","Cor2":"4-blue","Dados":"# dum_1 is T \n# dum_2 is R1 bulk water for T \n# dum_3 is concentration \n# dum_4 is Diffusion for T \n\n# DATA dum=298 0.317 0.424 2.29e-9 \n# TAG = 10_1mg_298K_1:1\n# YAXIS Logarithmic 0.1 1000 10 9 power 0 R\\s1\\N\\SMP\\N[s\\S-1\\N\\8m\\4M\\S-1\\N] \n# XAXIS Logarithmic 10000 1e+09 10 9 power 0 Frequency [Hz] \n# TITLE \"\\-\\-NMP 10 nm in H\\s2\\N\\-\\-O\" 20000 500 \n# 